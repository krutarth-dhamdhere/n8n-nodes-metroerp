{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node10",
  },
  "include": ["index.js", "credentials/**/*.js", "nodes/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
