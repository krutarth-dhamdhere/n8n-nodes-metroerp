{
  "name": "n8n-nodes-metroerp",
  "version": "0.3.4",
  "description": "n8n node for MetroERP contacts, invoices, and vendor bills",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "metroerp",
    "metro",
    "accounting"
  ],
  "license": "MIT",
  "homepage": "https://metrogroup.solutions/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krutarth-dhamdhere/n8n-nodes-metroerp.git"
  },
  "author": {
    "name": "Metro Group Pte Ltd",
    "email": "support@metrogroup.solutions"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "n8n-node build && mkdir -p dist/nodes/MetroErp && cp nodes/MetroErp/MetroErp.node.json dist/nodes/MetroErp/MetroErp.node.json",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "release": "n8n-node release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/MetroErpApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MetroErp/MetroErp.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "eslint": "^9.29.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
